{
  "name": "discord-transcriptify",
  "version": "1.0.0",
  "description": "A nicely formatted html transcript generator for discord.js, with full Components V2 support.",
  "main": "dist/index.js",
  "homepage": "https://github.com/cauahzz/discord-transcriptify",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "ts-node ./tests/ssrf.ts && ts-node ./tests/render.ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test:typescript": "ts-node ./tests/generate.ts",
    "test:send-components-v2": "ts-node ./tests/components-v2-send.ts",
    "demo": "ts-node ./demo/generate.ts",
    "lint": "prettier --write --cache . && eslint --cache --fix .",
    "lint:check": "prettier --check . && eslint .",
    "typecheck": "tsc -p tsconfig.eslint.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cauahzz/discord-transcriptify.git"
  },
  "keywords": [
    "discord",
    "discord.js",
    "discordjs",
    "transcript",
    "discord-transcript",
    "discord-transcripts",
    "html-transcript",
    "html-transcripts",
    "discord-html-transcripts",
    "discord.js-transcripts",
    "discord.js-html-transcripts",
    "ticket-transcript",
    "discord-ticket",
    "chat-exporter",
    "discord-chat-exporter",
    "components-v2",
    "discord-polls",
    "voice-messages",
    "discord-bot",
    "discord-transcriptify"
  ],
  "author": {
    "name": "cauahzz",
    "url": "https://github.com/cauahzz"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "src/**/*.ts",
    "src/**/*.tsx",
    "NOTICE"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "discord.js": "14.27.0",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@derockdev/discord-components-core": "^3.6.1",
    "debug": "^4.4.3",
    "discord-markdown-parser": "~1.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-markdown": "^0.7.3",
    "twemoji": "^14.0.2",
    "undici": "^6.29.0"
  },
  "peerDependencies": {
    "discord.js": "^14.19.0 || ^15.0.0",
    "sharp": ">=0.32.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
